        Fork &copy; <a href="https://github.com/nodedropweb" target="_blank">nodedropweb</a> 2025
    </div>
</footer>

<!-- JAVASCRIPT -->

<script>
    // Simple error handler
    window.onerror = function (msg, url, linenumber) {
        // TODO: log to acp and deal with it, also better display (notification?)
        alert('Javascript error occurred: ' + msg + '\nURL: ' + url + '\nLine Number: ' + linenumber);
        return false // still run the default handler
    }
</script>

<!-- Theme switcher (must load before jQuery to prevent FOUC) -->
{$tplutils::includeScript("js/theme-switcher.js", true)}

<!-- jQuery 3.6.0 -->
{$tplutils::includeScript("{cdnjs}/jquery/3.6.0/jquery.min.js", true)}

<!-- Bootstrap 4.6.0 (bundle - includes Popper.js) -->
{$tplutils::includeScript("{cdnjs}/bootstrap/4.6.0/js/bootstrap.bundle.min.js", true)}

<!-- JS-Cookie 2.2.1 -->
{$tplutils::includeScript("{cdnjs}/js-cookie/2.2.1/js.cookie.min.js", true)}

<!-- day.js 1.10.4 -->
{$tplutils::includeScript("{cdnjs}/dayjs/1.10.4/dayjs.min.js", true)}
{$tplutils::includeScript("{cdnjs}/dayjs/1.10.4/plugin/localizedFormat.min.js", true)}
{$tplutils::includeScript("{cdnjs}/dayjs/1.10.4/plugin/relativeTime.min.js", true)}

{var $dayjslang = __get("DAYJS_LANG", [], true)}
{if $dayjslang !== null && $dayjslang !== "en"}
    {$tplutils::includeScript("{cdnjs}/dayjs/1.10.4/locale/$dayjslang.min.js", true)}
    <script>
        dayjs.locale({$dayjslang} || navigator.languages || navigator.language)
    </script>
{/if}

<!-- DataTables 1.10.21 + Support for Bootstrap 4 -->
{$tplutils::includeScript("{cdnjs}/datatables/1.10.21/js/jquery.dataTables.min.js", true)}
{$tplutils::includeScript("{cdnjs}/datatables/1.10.21/js/dataTables.bootstrap4.min.js", true)}

<!-- DataTables responsive plugin -->
{$tplutils::includeScript("{cdnjs}/datatables-responsive/2.2.7/dataTables.responsive.min.js", true)}

<!-- script.js -->
{$tplutils::includeScript("js/script.js", true)}
{$tplutils::includeScript("js/status.js", true)}
{$tplutils::includeScript("js/login.js", true)}

{block footerbottom}{/block}

<!-- Klaro: load after DOM, after klaro-config.js is already parsed -->
<script defer data-config="klaroConfig" src="lib/klaro/0.7/klaro.js"></script>

<!--
    TS-website {\__TSWEBSITE_VERSION} ({\__TSWEBSITE_COMMIT}) by Wruczek
