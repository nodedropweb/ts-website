{var $utils = Wruczek\TSWebsite\Utils\Utils::class}
{var $tplutils = Wruczek\TSWebsite\Utils\TemplateUtils::i()}
{var $auth = Wruczek\TSWebsite\Auth::class}
{var $userlangcode = $userLanguage->getLanguageCode()}
{var $navActiveIndex = isset($navActiveIndex) ? (int) $navActiveIndex : 0}<!DOCTYPE html>
<html n:attr="lang => $userlangcode">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="generator" content="TS-website {\__TSWEBSITE_VERSION} by Wruczek / https://github.com/Wruczek/ts-website">
    
    {var $description = $config["website_description"] ?? "TeamSpeak 3 community website."}
    {var $ogTitle = !empty($config["website_og_title"]) ? $config["website_og_title"] : ($title . " | " . $config["website_title"])}
    {var $ogImage = ($config["website_og_image_custom"] ?? false) ? "img/og-image.jpg" : "img/icons/defaulticon-512.png"}
    
    <meta name="description" content="{$description}">
    <meta property="og:title" content="{$ogTitle}">
    <meta property="og:description" content="{$description}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{Wruczek\TSWebsite\Config::get('baseurl')}/{$_SERVER['PHP_SELF']|replace:'.php',''}">
    <meta property="og:image" content="{$ogImage|noCheck}">

    <meta name="csrf-token" content="{$csrfToken}">
    
    {var $customFavicon = $config["website_favicon_custom"] ?? false}
    {var $customSiteIcon = $config["website_siteicon_custom"] ?? false}
    {if $customFavicon}
        <link rel="icon" type="image/png" sizes="16x16" href="img/icons/favicon-16.png">
        <link rel="icon" type="image/png" sizes="32x32" href="img/icons/favicon-32.png">
    {else}
        <link rel="icon" type="image/png" sizes="16x16" href="img/icons/defaulticon-16.png">
        <link rel="icon" type="image/png" sizes="32x32" href="img/icons/defaulticon-32.png">
    {/if}

    {if $customSiteIcon}
        <link rel="apple-touch-icon" href="img/icons/site-icon.png">
    {else}
        <link rel="apple-touch-icon" href="img/icons/defaulticon-256.png">
    {/if}

    <meta property="og:image" content="{$ogImage}">

    <!-- TODO make it use the language variable "WEBSITE_TITLE" after the ACP update -->
    <title>{$title} | {$config["website_title"]}</title>

    <!-- Bootstrap 4.6.0 -->
    {$tplutils::includeStylesheet("{cdnjs}/bootstrap/4.6.0/css/bootstrap.min.css", true)}

    <!-- FontAwesome CSS 5.15.3 -->
    {$tplutils::includeStylesheet("{cdnjs}/font-awesome/5.15.3/css/all.min.css", true)}

    <!-- DataTables 1.10.21 -->
    {$tplutils::includeStylesheet("{cdnjs}/datatables/1.10.21/css/dataTables.bootstrap4.min.css", true)}

    <!-- Internal scripts -->
    {$tplutils::includeStylesheet("css/flags/famfamfam-flags.min.css", true)}
    {$tplutils::includeStylesheet("css/style.css", true)}
    {$tplutils::includeStylesheet("css/loader.css", true)}
    <link id="theme-stylesheet" rel="stylesheet" href="css/themes/dark.css">

    <!-- Klaro consent manager -->
    {$tplutils::includeStylesheet("lib/klaro/0.7/klaro.min.css", true)}
    {$tplutils::includeScript("js/klaro-config.js", true)}

    {if __DEV_MODE}
        <!-- Dev script - added when dev mode is on -->
        {$tplutils::includeStylesheet("css/dev.css", true)}
    {/if}
</head>
<body n:attr="class => 'lang ' . $userlangcode">

<noscript>
    <div class="alert alert-danger noscript-alert bottom-error-alert" role="alert">
        {_"NO_JAVASCRIPT_ENABLED"}
    </div>
</noscript>

<div class="alert alert-danger oldbrowser-alert bottom-error-alert" role="alert" style="display: none">
    {_"UNSUPPORTED_BROWSER"}
</div>

{if !$auth::isLoggedIn()}
    {include "utils/modal-login.latte"}
{/if}

<nav id="main-navbar" class="navbar navbar-expand-lg fixed-top nav-fix-scroll navbar-dark bg-primary">
    <div class="container">
        <a class="navbar-brand" href=".">
            {var $logoUrl = $customSiteIcon ? "img/icons/site-icon.png" : "img/icons/defaulticon-64.png"}
            <img src="{$logoUrl}" width="32" height="32" class="d-inline-block align-top mr-1" alt="Brand image">
            {$config["nav_brand"]}
        </a>

        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNavbarNavDropdown"
                aria-controls="mainNavbarNavDropdown" aria-expanded="false" aria-label="{_"NAV_TOGGLE"}">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbarNavDropdown">
            <ul class="navbar-nav">
                <li class="nav-item{if $navActiveIndex === 1} active{/if}">
                    <a class="nav-link" href="viewer.php"><i class="fas fa-eye"></i>{_"NAV_VIEWER"}</a>
                </li>
                <li class="nav-item{if $navActiveIndex === 2} active{/if}">
                    <a class="nav-link" href="assigner.php"><i class="fas fa-gamepad"></i>{_"NAV_ASSIGNER"}</a>
                </li>
                <li class="nav-item{if $navActiveIndex === 3} active{/if}">
                    <a class="nav-link" href="bans.php"><i class="fas fa-ban"></i>{_"NAV_BANS"}</a>
                </li>
                <li class="nav-item{if $navActiveIndex === 4} active{/if}">
                    <a class="nav-link" href="rules.php"><i class="fas fa-book"></i>{_"NAV_RULES"}</a>
                </li>
                <li class="nav-item{if $navActiveIndex === 5} active{/if}">
                    <a class="nav-link" href="faq.php"><i class="far fa-question-circle"></i>{_"NAV_FAQ"}</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-md-auto">

                {if $auth::isLoggedIn()}
                    <li class="nav-item dropdown">
                        <a class="nav-link login-button text-truncate dropdown-toggle" href="#" id="navbarDropdownUser" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-user"></i>{$auth::getNickname()}
                        </a>
                            <div class="dropdown-menu" aria-labelledby="navbarDropdownUser">
                            <button class="dropdown-item logoutUser"><i class="fas fa-sign-out-alt"></i>{_"NAV_ACCOUNT_LOGOUT"}</button>
                        </div>
                    </li>
                {else}
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-openLoginModal><i class="fas fa-sign-in-alt"></i>{_"NAV_ACCOUNT_LOGIN"}</a>
                    </li>
                {/if}

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownTheme" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-palette"></i> Theme
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdownTheme">
                        <h6 class="dropdown-header">Theme</h6>
                        <button class="dropdown-item" data-theme="dark">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#1e202f;margin-right:6px;vertical-align:middle;border:2px solid #a61f67"></span>Dark
                        </button>
                        <button class="dropdown-item" data-theme="light">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#5c6bc0;margin-right:6px;vertical-align:middle;border:2px solid #e8eaf6"></span>Light
                        </button>
                        <button class="dropdown-item" data-theme="acrylic">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:linear-gradient(135deg,#7c83f5,#a78bfa);margin-right:6px;vertical-align:middle;border:2px solid rgba(255,255,255,.3)"></span>Acrylic
                        </button>
                        <button class="dropdown-item" data-theme="acrylic-midnight">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:linear-gradient(135deg,#0d1b3e,#4fc3f7);margin-right:6px;vertical-align:middle;border:2px solid rgba(79,195,247,.4)"></span>Acrylic Midnight
                        </button>
                        <button class="dropdown-item" data-theme="acrylic-ember">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:linear-gradient(135deg,#3a0800,#ff7043);margin-right:6px;vertical-align:middle;border:2px solid rgba(255,112,67,.4)"></span>Acrylic Ember
                        </button>
                        <button class="dropdown-item" data-theme="acrylic-forest">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:linear-gradient(135deg,#051a0e,#4caf78);margin-right:6px;vertical-align:middle;border:2px solid rgba(76,175,120,.4)"></span>Acrylic Forest
                        </button>
                    </div>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownLanguageChooser" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-language"></i>{$userLanguage->getLanguageNameNative()}
                    </a>
                    <form method="post" action="api/setlang.php">
                        {$csrfField}
                        <input type="hidden" name="return-to" value="{$_SERVER['PHP_SELF']}">

                        <div class="dropdown-menu" aria-labelledby="navbarDropdownLanguageChooser">
                            <button name="lang" class="dropdown-item{if $lang->getLanguageCode() === $userlangcode} active{/if}"
                                n:foreach="$languageList as $lang"
                                n:attr="value => $lang->getLanguageCode(), title => $lang->getLanguageNameEnglish()">
                                {$lang->getLanguageNameNative()}
                            </button>
                        </div>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container">
    {ifset $oldestTimestamp}
        {include "utils/data-problem.latte", message => ("OUTDATED_DATA"|translate,($oldestTimestamp|fuzzyDateAbbr))}
    {/ifset}

    {if $tsExceptions}
        {include "utils/data-problem.latte", message => "We are having trouble communicating with the server. Some parts of the website might not be working as expected."}
    {/if}

    <div class="row">
        <!-- 1st column -->
        <div class="col-lg-9">
            {block content}{/block}
        </div>

        <!-- 2nd column -->
        <div class="col-lg-3">
            {include "sidebar.latte"}
        </div>
    </div>
</div>

<footer class="footer d-md-flex">
    <div>
        &copy; {$config["website_title"]} {date("Y")}

        {if $config["imprint_enabled"]}
            &mdash; <a href="{$config["imprint_url"]}">{_'IMPRINT_TITLE'}</a>
        {/if}
    </div>
    <div class="ml-auto footer-copyright">
        <!-- Please respect the amount of work we've put for free into this project and leave the authors in the footer. Thanks! -->
        <a href="https://github.com/nodedropweb/ts-website" target="_blank">ts-website</a> v {\__TSWEBSITE_VERSION} &mdash;
