msgid "INSTALLER_DONE_TITLE"
msgstr "TS-website {0} has been successfully installed! \xF0\x9F\x91\x8D"

msgid "INSTALLER_DONE_REMOVE_DIR"
msgstr "If you wish, you can remove the <code>installer</code> directory."

msgid "INSTALLER_DONE_WHATNOW"
msgstr "What now?"

msgid "INSTALLER_DONE_DONATE_TITLE"
msgstr "Donate"

msgid "INSTALLER_DONE_DONATE_SUB"
msgstr "to keep this project alive"

msgid "INSTALLER_DONE_TELEGRAM_TITLE"
msgstr "Join our telegram group"

msgid "INSTALLER_DONE_TELEGRAM_SUB"
msgstr "news, announcements and support"

msgid "INSTALLER_DONE_VISIT_TITLE"
msgstr "Visit your new website"

msgid "INSTALLER_DONE_SPREAD_TITLE"
msgstr "Spread the message"

msgid "INSTALLER_DONE_SPREAD_SUB"
